#!/usr/bin/env bash
# Launch the system mpv with the project's portable config dir and a unique IPC socket per instance.
# Usage: bin/mpv-uos [mpv options] [files/URLs]   (any mpv option given here overrides mpv-config/mpv.conf)
# Env: MPV_UOS_MPV (mpv binary, default "mpv"), MPV_UOS_RUNTIME_DIR (socket dir),
#      MPV_UOS_DATA_DIR (user data: favourites, notes, watch_later, prefs; default $XDG_DATA_HOME/mpv-uos).
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONFIG_DIR="$ROOT/mpv-config"
MPV_BIN="${MPV_UOS_MPV:-mpv}"
RUNTIME_DIR="${MPV_UOS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/mpv-uos}"
mkdir -p "$RUNTIME_DIR"

# Sockets of mpv processes that are gone (mpv never removes its IPC socket on exit). The name after `mpv-`
# IS the pid: anything else is not ours and is never touched, so whoever creates sockets here (the test
# harness included) must not use a name that can be read as a pid, or a live instance loses its socket.
for s in "$RUNTIME_DIR"/mpv-*.sock; do
  [ -e "$s" ] || continue
  pid="${s##*/mpv-}"; pid="${pid%.sock}"
  case "$pid" in ''|*[!0-9]*) continue ;; esac
  kill -0 "$pid" 2>/dev/null || rm -f "$s"
done

# One socket per instance, never inherited: a file manager opened from mpv would otherwise pass it on to the
# next mpv-uos, and two players would share one socket (and one mpvd session).
# `exec` below keeps this shell's PID for mpv, so the socket name matches the mpv process.
unset MPV_UOS_SOCKET
SOCKET="$RUNTIME_DIR/mpv-$$.sock"

# User data lives outside the checkout (a `rm -rf .cache` must never take favourites or notes with it).
# One-time migration from the old in-checkout locations, only for the default location (tests and scripts that
# choose their own MPV_UOS_DATA_DIR never receive the user's data). Copied: the originals stay as a backup.
migrate=0
[ -z "${MPV_UOS_DATA_DIR:-}" ] && migrate=1
DATA_DIR="${MPV_UOS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mpv-uos}"
if [ ! -d "$DATA_DIR" ]; then
  mkdir -p "$DATA_DIR"
  if [ "$migrate" = 1 ] && [ -d "$ROOT/.cache/data" ]; then cp -a "$ROOT/.cache/data/." "$DATA_DIR/" 2>/dev/null || true; fi
fi
if [ ! -d "$DATA_DIR/watch_later" ]; then
  mkdir -p "$DATA_DIR/watch_later"
  # Old watch_later entries also carried global options (volume, speed, filters) that leaked into the next file:
  # keep only the per-file keys listed in mpv.conf (watch-later-options).
  if [ "$migrate" = 1 ] && [ -d "$CONFIG_DIR/watch_later" ]; then
    keep='^(#|start=|edition=|aid=|sid=|secondary-sid=|audio-delay=|sub-delay=|secondary-sub-delay=|sub-speed=|ab-loop-a=|ab-loop-b=|video-aspect-override=|panscan=|video-zoom=|video-pan-x=|video-pan-y=|video-rotate=|video-crop=|deinterlace=)'
    for f in "$CONFIG_DIR"/watch_later/*; do
      [ -f "$f" ] && grep -E "$keep" "$f" > "$DATA_DIR/watch_later/${f##*/}" || true
    done
  fi
fi
export MPV_UOS_ROOT="$ROOT"
export MPV_UOS_DATA_DIR="$DATA_DIR"

# «Enviar a MPV-UOS» from the browser (H23): mpv-uos://download?url=<url>[&preset=<id>] queues the download in
# mpvd (started if needed) and shows a desktop notification; no player window opens.
dl_links=()
for a in "$@"; do case "$a" in mpv-uos://download\?*) dl_links+=("$a") ;; esac; done
if [ "${#dl_links[@]}" -gt 0 ]; then
  PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY="$ROOT/.venv/Scripts/python.exe"; [ -x "$PY" ] || PY=python3
  export MPV_UOS_ROOT="$ROOT" PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
  exec "$PY" -m mpvd link --root "$ROOT" "${dl_links[@]}"
fi

# Links from «Mis notas» (mpv-uos://open?path=<url-encoded>&t=<seconds>, registered by the desktop entry): open that
# file at that minute with per-file options. The desktop entry passes them after `--`, where `--{` would be a file
# name, so the groups go before the first `--`.
urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }
plain=(); links=()
for a in "$@"; do
  case "$a" in
    mpv-uos://open\?*)
      p=""; t=""
      IFS='&' read -r -a kv <<<"${a#*\?}"
      for x in "${kv[@]}"; do
        case "$x" in path=*) p="$(urldecode "${x#path=}")" ;; t=*) t="${x#t=}" ;; esac
      done
      [[ "$t" =~ ^[0-9]+(\.[0-9]+)?$ ]] || t=""
      if [ -n "$p" ] && [ -n "$t" ]; then links+=(--\{ "--start=$t" "$p" --\}); elif [ -n "$p" ]; then links+=("$p"); fi ;;
    *) plain+=("$a") ;;
  esac
done
if [ "${#links[@]}" -gt 0 ]; then
  rebuilt=(); placed=0
  for a in "${plain[@]}"; do
    if [ "$a" = "--" ] && [ "$placed" = 0 ]; then rebuilt+=("${links[@]}"); placed=1; fi
    rebuilt+=("$a")
  done
  [ "$placed" = 0 ] && rebuilt+=("${links[@]}")
  set -- "${rebuilt[@]}"
fi

# Always stay open when idle: with idle=no (or pseudo-gui's idle=once) a file that fails to load closes the
# player without a word; idle keeps the window, shows the error and the home screen. Without files/URLs, open
# the window like the desktop entry does, unless the caller chose --idle or an operation mode.
extra=()

# Entrar en una sala (H44/C6): un enlace de invitación (…/s/<sala>#k=<token>) NO es algo que reproducir. Si se lo
# pasáramos a mpv, yt-dlp intentaría descargar una página HTML. Se saca de la lista y se le deja a mu-share, que
# entra por mpvd en cuanto el demonio contesta. El token va en el fragmento, así que nunca sale de este equipo
# hasta que mpvd lo manda en el cuerpo de la petición, igual que hace la página.
join_url=""; rest=()
for a in "$@"; do
  case "$a" in
    http://*/s/*#k=*|https://*/s/*#k=*)
      if [ -z "$join_url" ]; then join_url="$a"; else rest+=("$a"); fi ;;
    *) rest+=("$a") ;;
  esac
done
if [ -n "$join_url" ]; then
  set -- ${rest[@]+"${rest[@]}"}
  extra+=("--script-opts-append=mu-share-join=$join_url")
fi

has_target=0; has_mode=0; has_idle=0; after_dd=0
for a in "$@"; do
  if [ "$after_dd" = 1 ]; then has_target=1; continue; fi
  case "$a" in
    --) after_dd=1 ;;
    --idle|--idle=*|--no-idle) has_idle=1; has_mode=1 ;;
    --player-operation-mode=*) has_mode=1 ;;
    -*) ;;
    *) has_target=1 ;;
  esac
done
[ "$has_target" = 0 ] && [ "$has_mode" = 0 ] && extra+=(--player-operation-mode=pseudo-gui)
[ "$has_idle" = 0 ] && extra+=(--idle=yes)

# H49 · el idioma se decide AQUÍ, antes de que cargue el primer script, para que la pantalla de inicio no salga en
# un idioma y cambie al siguiente (mpv no expone ninguna propiedad de idioma: la fuente es el entorno, en el orden
# de POSIX). Regla: castellano o francés → ese; inglés o cualquier otro → inglés. MPV_UOS_LANG lo fuerza.
# uosc ya trae sus propias traducciones (scripts/uosc/intl): se le dice el idioma y no se duplica nada.
mu_lang="${MPV_UOS_LANG:-}"
# La preferencia de *Preferencias → Idioma*, que gana al entorno. prefs.json es un fichero plano, así que se puede
# leer aquí; el `grep` primero para no pagar un arranque de Python en cada apertura si no hay nada guardado.
if [ -z "$mu_lang" ] && [ -f "$DATA_DIR/prefs.json" ] && grep -q '"lang"' "$DATA_DIR/prefs.json" 2>/dev/null; then
  mu_py="$ROOT/.venv/bin/python"; [ -x "$mu_py" ] || mu_py="$ROOT/.venv/Scripts/python.exe"
  [ -x "$mu_py" ] || mu_py=python3
  mu_lang="$("$mu_py" -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
v = (d.get("mu-menu") or {}).get("lang") or ""
print(v if v in ("es", "en", "fr") else "")' "$DATA_DIR/prefs.json" 2>/dev/null || true)"
fi
if [ -z "$mu_lang" ]; then
  for v in "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
    case "$v" in ''|C|C.*|POSIX) continue ;; esac
    case "$v" in es*) mu_lang=es ;; fr*) mu_lang=fr ;; *) mu_lang=en ;; esac
    break
  done
fi
case "$mu_lang" in es|en|fr) ;; *) mu_lang=en ;; esac
extra+=("--script-opts-append=mu-core-lang=$mu_lang" "--script-opts-append=uosc-languages=$mu_lang,slang,en")

# H72 · El mpv es el del sistema (ADR-067), y en Debian 13 o Raspberry Pi OS puede ser más viejo que el probado.
# Instalarse y avisar es mejor que negarse a instalar, así que aquí se mira la versión y se le dice a mu-core, que
# lo cuenta en pantalla una sola vez. `mpv --version` dice «mpv v0.41.0 …» en la primera línea.
# OJO con la tubería: `mpv --version | head -1` le cierra la salida a mpv, que muere con SIGPIPE, y con
# `pipefail` eso aborta ESTE script antes de arrancar nada. Pasó, y se vio porque el reproductor no abría. `awk`
# lee toda la salida y solo mira la primera línea, así que no hay tubería que cerrar.
MPV_MIN_MAJOR=0; MPV_MIN_MINOR=41
mu_mpv_ver="$("$MPV_BIN" --version 2>/dev/null | awk 'NR == 1 && $2 ~ /^v[0-9]+\.[0-9]+/ {
    sub(/^v/, "", $2); split($2, parte, "."); print parte[1] "." parte[2] }' || true)"
if [ -n "$mu_mpv_ver" ]; then
  mu_mayor="${mu_mpv_ver%%.*}"; mu_menor="${mu_mpv_ver#*.}"
  if [ "$mu_mayor" -lt "$MPV_MIN_MAJOR" ] 2>/dev/null ||
     { [ "$mu_mayor" -eq "$MPV_MIN_MAJOR" ] && [ "$mu_menor" -lt "$MPV_MIN_MINOR" ]; } 2>/dev/null; then
    extra+=("--script-opts-append=mu-core-mpv_old=$mu_mpv_ver")
  fi
fi
exec "$MPV_BIN" --config-dir="$CONFIG_DIR" --input-ipc-server="$SOCKET" --watch-later-dir="$DATA_DIR/watch_later" \
  "${extra[@]}" "$@"
