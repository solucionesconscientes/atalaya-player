#!/usr/bin/env bash
# Launch the system mpv with the project's portable config dir and a unique IPC socket per instance.
# Usage: bin/mpv-uos [mpv options] [files/URLs]   (any mpv option given here overrides mpv-config/mpv.conf)
# Env: MPV_UOS_MPV (mpv binary, default "mpv"), MPV_UOS_RUNTIME_DIR (socket dir), MPV_UOS_SOCKET (explicit socket).
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONFIG_DIR="$ROOT/mpv-config"
MPV_BIN="${MPV_UOS_MPV:-mpv}"
RUNTIME_DIR="${MPV_UOS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/mpv-uos}"
mkdir -p "$RUNTIME_DIR"
# `exec` below keeps this shell's PID for mpv, so the socket name matches the mpv process.
SOCKET="${MPV_UOS_SOCKET:-$RUNTIME_DIR/mpv-$$.sock}"
export MPV_UOS_ROOT="$ROOT"
export MPV_UOS_SOCKET="$SOCKET"
# Without files/URLs mpv prints its usage and exits: open the window with the home screen instead
# (same as the desktop entry), unless the caller already chose --idle or an operation mode.
extra=()
has_target=0; has_mode=0; after_dd=0
for a in "$@"; do
  if [ "$after_dd" = 1 ]; then has_target=1; continue; fi
  case "$a" in
    --) after_dd=1 ;;
    --idle|--idle=*|--player-operation-mode=*) has_mode=1 ;;
    -*) ;;
    *) has_target=1 ;;
  esac
done
[ "$has_target" = 0 ] && [ "$has_mode" = 0 ] && extra=(--player-operation-mode=pseudo-gui)
exec "$MPV_BIN" --config-dir="$CONFIG_DIR" --input-ipc-server="$SOCKET" "${extra[@]}" "$@"
